  },
  "homepage": "https://github.com/chiayumd15/h3-live#readme",
  "private": "true",
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
